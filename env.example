# NVIDIA NIM API Configuration
# Get your free API key from: https://build.nvidia.com/
# Model: mistralai/mistral-small-4-119b-2603 (Mistral Small 4, 119B parameters)
# 
# Steps to get your API key:
# 1. Go to https://build.nvidia.com/
# 2. Sign up / sign in
# 3. Navigate to https://build.nvidia.com/mistralai/mistral-small-4-119b-2603
# 4. Click "Get API Key"
# 5. Copy the key and paste it below (starts with nvapi-)
#
# The free tier provides enough credits for typical usage.
NVIDIA_API_KEY=nvapi-your-key-here

# Optional: Azure Speech Services for voice input (leave empty to disable)
# AZURE_SPEECH_KEY=your_azure_speech_key
# AZURE_SPEECH_REGION=eastus
